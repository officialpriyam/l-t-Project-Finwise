# ---------------------------------------------------------------------------
# FinWise — environment
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the app. Used for auth callbacks, webhook URLs, and links in
# notification emails. It must match exactly on the web and API, with no path.
# Full-stack Vercel uses two projects: web Root Directory apps/web and API Root
# Directory apps/api. Both use the public web APP_URL; only the web project needs
# API_INTERNAL_URL, set to the public API origin with no /api suffix. Database,
# auth, encryption, AI, storage and cron secrets belong only in the API project.
APP_URL=http://localhost:3100

# --- Database (PostgreSQL) --------------------------------------------------
# Local: `pnpm db:local` (embedded) or `docker compose up -d postgres`, both on 5436.
# Hosted (Neon, RDS, …) works too: give the app the pooled host and use the
# direct host (drop "-pooler") for migrations and scripts.
DATABASE_URL=postgres://finwise:finwise@localhost:5436/finwise
# Used only by the PostgreSQL-backed integration tests. Must be a separate
# database: the tests truncate every table.
DATABASE_URL_TEST=postgres://finwise:finwise@localhost:5436/finwise_test

# --- Authentication (Better Auth) -------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to "false" to stop new sign-ups on a private, single-owner install.
ALLOW_SIGN_UP=true

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key for integration credentials and webhook secrets, base64 of
# exactly 32 bytes. Generate with:  openssl rand -base64 32
# Rotating it makes stored integration credentials unreadable; reconnect them.
ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# The simplest way: choose the provider, model and key in the app (Admin → AI);
# those settings win over everything below. These are the server defaults.
#
# AI_PROVIDER: anthropic, deepseek, openai, gemini, openrouter, groq, mistral,
# xai, qwen, moonshot, together, ollama, lmstudio, custom (any OpenAI-compatible
# endpoint), or none. With none (or no key) the app runs on its deterministic
# parsers and rules: manual review replaces AI extraction.
# Recommended: Gemini 3 Flash — fast, strong structured output and a usable
# free tier at Google AI Studio.
AI_PROVIDER=gemini
# Empty = the provider's recommended model. Gemini 3 Flash is `gemini-3-flash-preview`.
AI_MODEL=gemini-3-flash-preview
# Each provider reads its own key; AI_API_KEY works for whichever AI_PROVIDER names.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Google AI Studio sometimes labels the same key GOOGLE_API_KEY; either name works for Gemini.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# When the OpenRouter key above is set, transport failures on the primary provider
# (rate limits, overload, timeouts) retry once on this model. `openrouter/free` is
# OpenRouter's free-tier router.
OPENROUTER_FALLBACK_MODEL=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
TOGETHER_API_KEY=
AI_API_KEY=
# Endpoint override for OpenAI-compatible providers (required for custom).
AI_BASE_URL=
# Some models (DeepSeek V4 Pro, Llama, …) can't read images. A second model for
# screenshots, receipts and PDFs, e.g. AI_VISION_PROVIDER=gemini.
AI_VISION_PROVIDER=none
AI_VISION_MODEL=
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
# Monthly AI spend ceiling per workspace in USD. Above it, AI features fall
# back to deterministic processing until the next month. 0 disables the cap.
AI_MONTHLY_BUDGET_USD=25

# --- File storage -----------------------------------------------------------
# The simplest way: set up Cloudflare R2 or any S3-compatible bucket in the app
# (Admin → Storage); a bucket saved there wins over everything below for new files.
# "local" writes under STORAGE_LOCAL_DIR (development, single server).
# "s3" uses any S3-compatible store (AWS S3, Cloudflare R2, MinIO, RustFS).
# Vercel has no durable filesystem: use S3/R2 there or uploads return 503.
# Vercel's default request-body limit is 4.5 MB. For this app's 12 MB upload cap,
# use Fluid Compute on Pro/Enterprise with 4 GB Performance memory, Node.js and
# VERCEL_SUPPORT_LARGE_REQUEST_BODY=1 (Vercel's 20 MiB request-body beta).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing for MinIO/RustFS.
S3_FORCE_PATH_STYLE=false
# VERCEL_SUPPORT_LARGE_REQUEST_BODY=1

# --- Background jobs --------------------------------------------------------
# "true" runs the job worker (queue, domain events, scheduled tasks) inside the
# API process: fine for one server. Set "false" on the API and run
# `pnpm worker` (node dist/bootstrap/worker.js) as its own process to scale out; any
# number of workers can share the queue, and each scheduled task runs once per
# slot however many processes run the scheduler.
RUN_WORKER_IN_PROCESS=true
# On the Vercel API project set RUN_WORKER_IN_PROCESS=false and
# EW_DISABLE_WORKER=1. Vercel Cron calls GET /api/system/cron every minute with
# Authorization: Bearer <CRON_SECRET>; it runs due schedules and drains jobs.
# Minute cron requires Pro/Enterprise (Hobby allows daily cron only).
# The legacy POST /api/system/tick uses header `x-cron-secret` for one worker pass.
# Use a random header-safe secret of at least 16 characters.
CRON_SECRET=
# EW_DISABLE_WORKER=1

# --- Email ------------------------------------------------------------------
# Verification, password reset, invitations, receipts and alerts are sent
# through Resend. Without a key, emails are written to the API log instead
# (fine for development, not for production).
RESEND_API_KEY=
EMAIL_FROM="FinWise <alerts@example.com>"
# Where support requests are delivered.
SUPPORT_EMAIL=
# Sign-in waits for a verified email. Defaults to true when NODE_ENV=production.
REQUIRE_EMAIL_VERIFICATION=

# --- Sign in with Google (optional) -----------------------------------------
# OAuth client from Google Cloud Console; redirect URI:
#   <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Operations -------------------------------------------------------------
# Error reports to Sentry (or a Sentry-compatible service such as GlitchTip).
SENTRY_DSN=
# "json" for one JSON object per log line.
LOG_FORMAT=text
# Express "trust proxy" for the API: decides request.ip (rate limits, audit).
# 1 covers the web server's /api proxy plus one reverse proxy in front of it
# (the web server keeps that proxy's X-Forwarded-For). With a chain in front of
# the web server (a CDN, then a load balancer) use the number of proxies (2).
# Also accepts true, false, or a comma-separated list of proxy addresses.
TRUST_PROXY=1
# Database connections per process. On Vercel start with 1 and increase only
# within the managed database's connection budget.
DATABASE_POOL_MAX=10
# After rotating ENCRYPTION_KEY, list the old key(s) here (comma-separated)
# and run `pnpm --filter @finwise/api rotate-keys` to re-encrypt.
ENCRYPTION_KEY_PREVIOUS=

# --- API server (NestJS) ---
API_PORT=4100
# Web project only: where server-side fetches and the /api proxy reach the API.
# On Vercel use the public API HTTPS origin with no /api suffix; it is compiled
# into the web build, so set it before deploying.
API_INTERNAL_URL=http://localhost:4100
# Comma-separated emails that receive the platform admin role on sign-up.
ADMIN_EMAILS=
